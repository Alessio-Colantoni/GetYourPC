JDBC_DATABASE_URL=jdbc:postgresql://HOST:PORT/NOME_DATABASE?sslmode=require
# In alternativa alla URL JDBC:
# DATABASE_URL=postgresql://UTENTE:PASSWORD@HOST:PORT/NOME_DATABASE?sslmode=require
DB_USERNAME=utente_postgres
DB_PASSWORD=password_postgres
PORT=8080
GEOAPIFY_API_KEY=chiave_geoapify
# GEOAPIFY_BASE_URL=https://api.geoapify.com
MAILJET_API_KEY=chiave_api_pubblica_mailjet
MAILJET_SECRET_KEY=chiave_segreta_mailjet
MAILJET_SENDER_EMAIL=mittente_verificato_su_mailjet@example.com
MAILJET_SENDER_NAME=GetYourPC
# MAILJET_BASE_URL=https://api.mailjet.com
DB_POOL_SIZE=5
# Cron Spring facoltativo per eliminare verifiche scadute e vecchi rate limit.
# MAINTENANCE_CLEANUP_CRON=0 */15 * * * *
# Durata minima della risposta di recupero password per ridurre l'enumerazione via timing.
# FORGOT_PASSWORD_MINIMUM_RESPONSE_MS=1000
# Usare false solo in sviluppo locale HTTP e true quando il servizio è esposto via HTTPS.
SESSION_COOKIE_SECURE=false
# Bootstrap opzionale del primo account. Abilitare solo per un deploy, poi
# riportare BOOTSTRAP_ACCOUNT_ENABLED a false e rimuovere la password dall'ambiente.
BOOTSTRAP_ACCOUNT_ENABLED=false
BOOTSTRAP_ACCOUNT_EMAIL=
BOOTSTRAP_ACCOUNT_PASSWORD=
BOOTSTRAP_ACCOUNT_NAME=
BOOTSTRAP_ACCOUNT_SURNAME=
